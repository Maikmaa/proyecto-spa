/* Estilos provisionales del proyecto SPA */

body {
    margin: 0;
    padding: 0;
    font-family: 'Montserrat', sans-serif;
    background-color: #F7F3EA;
    color: #2F4F3A;
}

main {
    max-width: 800px;
    margin: 64px auto;
    padding: 32px;
    text-align: center;
    background-color: #FFFFFF;
    border-radius: 12px;
}

h1 {
    font-size: 40px;
    font-weight: 700;
}

p {
    font-size: 16px;
    font-weight: 400;
    color: #333333;
}

button {
    background-color: #6B8F71;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 16px 24px;
}
